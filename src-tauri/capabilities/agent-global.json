{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agent-global",
  "description": "Capability for the multi-repo Jingling agent window (AgentHost = global)",
  "windows": ["agent-global", "jinglv"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "sql:default",
    "sql:allow-select",
    "store:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "log:default"
  ]
}
